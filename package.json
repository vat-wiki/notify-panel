{
  "name": "notify-panel-monorepo",
  "private": true,
  "description": "AI agent 的通知收件箱 —— 汇聚 CI/cron/webhook/监控等外部事件,供 AI agent 查收与自动处理",
  "keywords": [
    "ai-agent",
    "agent",
    "notification",
    "event-bus",
    "daemon"
  ],
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vat-wiki/notify-panel.git"
  }
}
