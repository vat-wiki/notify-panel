{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    // 允许子路径导入 notify-panel/protocol 等 → 指向 src
    "paths": {
      "notify-panel": ["./src/index.ts"],
      "notify-panel/protocol": ["./src/protocol/index.ts"],
      "notify-panel/core": ["./src/core/index.ts"],
      "notify-panel/sdk": ["./src/sdk/index.ts"],
      "notify-panel/server": ["./src/server/index.ts"],
      "notify-panel/cli": ["./src/cli/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
