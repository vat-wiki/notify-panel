{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notify-panel.dev/schemas/notify-batch.v1.json",
  "title": "NotifyBatch",
  "description": "Notify Panel 开放协议 v1 —— 批量推送",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "items"],
  "properties": {
    "source": { "type": "string", "minLength": 1, "maxLength": 64 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "notify-payload.v1.json" }
    }
  }
}
